# 复制为 .env.development（本地）或 .env.production（构建）。
# 所有 VITE_* 都是浏览器公开配置；凭据只在后端配置。
VITE_APP_ENV=development
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://127.0.0.1:3000
# 填自己创建的旧分发租户ID；留空时显示配置提示，不使用任何原业务租户。
VITE_DEFAULT_TENANTS_ID=
# 自有公众号配置完成后才开启，默认使用手机号登录。
VITE_ENABLE_WECHAT_OAUTH=false
VITE_WECHAT_OAUTH_API_BASE_URL=
VITE_WECHAT_OAUTH_RETURN_ORIGIN=auto
# 可选：自行准备且有权使用的公开 HTTPS 图片完整URL；留空不设置自定义分享图。
VITE_WECHAT_SHARE_IMAGE_URL=
