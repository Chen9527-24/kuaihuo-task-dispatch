generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id               String    @id @default(cuid())
  name             String    @db.VarChar(100)
  code             String    @unique @db.VarChar(64)
  status           String    @default("ACTIVE") @db.VarChar(32) // tenant_status
  industry         String?   @db.VarChar(255)
  productIntro     String?
  coreSellingPoint String?
  startedAt        DateTime
  expiredAt        DateTime
  remark           String?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  users         User[]
  memberships   UserTenantMembership[]
  mediaAccounts MediaAccount[]
  dailyTasks    DailyTask[]
  appUsers      AppUser[]
  withdrawals   AppUserWithdrawal[]
  testDataBatches TestDataBatch[]

  @@index([status])
  @@index([expiredAt])
  @@index([deletedAt])
}

model User {
  id           String    @id @default(cuid())
  tenantId     String?
  username     String    @unique @db.VarChar(32)
  passwordHash String
  displayName  String    @db.VarChar(50)
  phone        String?   @db.VarChar(20)
  avatarUrl    String?
  avatarFileId String?
  status       String    @default("ENABLED") @db.VarChar(32) // user_status
  remark       String?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant                      Tenant?                @relation(fields: [tenantId], references: [id])
  memberships                 UserTenantMembership[]
  roles                       UserRole[]
  uploads                     UploadFile[]           @relation("UploaderFiles")
  createdTasks                DailyTask[]            @relation("DailyTaskCreator")
  assignedComments            TaskComment[]          @relation("CommentAssignee")
  settledParticipants         TaskParticipant[]      @relation("TaskParticipantSettler")
  operatedAppUserRestrictions AppUserRestriction[]   @relation("AppUserRestrictionOperator")

  @@index([tenantId])
  @@index([phone])
  @@index([status])
  @@index([deletedAt])
}

model Role {
  id          String   @id @default(cuid())
  tenantId    String?
  code        String   @unique @db.VarChar(64)
  name        String   @db.VarChar(100)
  scope       String   @default("PLATFORM") @db.VarChar(32) // PLATFORM / TENANT
  status      String   @default("ENABLED") @db.VarChar(32) // role_status
  description String?
  remark      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]

  @@index([tenantId])
  @@index([scope])
  @@index([status])
}

model Permission {
  id        String   @id @default(cuid())
  parentId  String?
  code      String   @unique @db.VarChar(100)
  name      String   @db.VarChar(100)
  group     String   @default("system") @db.VarChar(32)
  type      String   @default("BUTTON") @db.VarChar(32) // permission_type
  status    String   @default("ENABLED") @db.VarChar(32) // permission_validation_status
  sort      Int      @default(0)
  routePath String?
  component String?
  icon      String?
  remark    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Permission?      @relation("PermissionTree", fields: [parentId], references: [id])
  children Permission[]     @relation("PermissionTree")
  roles    RolePermission[]

  @@index([parentId])
  @@index([type])
  @@index([status])
}

/// 官网全局内容配置。PC 只编辑草稿，公开站点只读取已发布内容；两者分离，避免未完成内容直接上线。

/// 官网联系表单的不可覆盖原始快照。业务跟进继续使用 CustomerLead，来源证据和投放参数保留在这里。

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  assignedAt   DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model DictType {
  id        String   @id @default(cuid())
  code      String   @unique @db.VarChar(64)
  name      String   @db.VarChar(100)
  status    String   @default("ENABLED") @db.VarChar(32)
  remark    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items DictItem[]

  @@index([status])
}

model DictItem {
  id        String   @id @default(cuid())
  typeCode  String   @db.VarChar(64)
  label     String   @db.VarChar(100)
  value     String   @db.VarChar(64)
  color     String?
  sort      Int      @default(0)
  status    String   @default("ENABLED") @db.VarChar(32)
  remark    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  type DictType @relation(fields: [typeCode], references: [code], onDelete: Cascade)

  @@unique([typeCode, value])
  @@index([typeCode, status])
}

model MediaAccount {
  id          String    @id @default(cuid())
  tenantId    String
  platform    String    @db.VarChar(32) // media_platform
  accountId   String    @db.VarChar(100)
  accountName String    @db.VarChar(100)
  status      String    @default("ENABLED") @db.VarChar(32)
  positioning String?
  remark      String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  dailyTasks DailyTask[]

  @@index([tenantId, platform])
  @@index([status])
  @@index([deletedAt])
}

model UserTenantMembership {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  status    String   @default("ENABLED") @db.VarChar(32)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([userId, status])
  @@index([tenantId, status])
}

model UploadFile {
  id            String   @id @default(cuid())
  uploaderId    String?
  memberId      String?
  scene         String?  @db.VarChar(64) // file_scene
  status        String   @default("TEMP") @db.VarChar(32) // TEMP / ACTIVE / DELETED
  storageDriver String   @db.VarChar(16)
  bucket        String?
  objectKey     String
  originalName  String
  mimeType           String   @db.VarChar(120)
  size               Int
  url                String
  thumbnailObjectKey String?
  thumbnailMimeType  String?  @db.VarChar(120)
  thumbnailSize      Int?
  imageWidth         Int?
  imageHeight        Int?
  createdAt          DateTime @default(now())

  member AppUser? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  uploader User?       @relation("UploaderFiles", fields: [uploaderId], references: [id], onDelete: Cascade)
  usages   FileUsage[]

  @@index([memberId, createdAt])
  @@index([uploaderId, createdAt])
  @@index([scene])
  @@index([status])
}

model FileUsage {
  id        String   @id @default(cuid())
  fileId    String
  bizType   String   @db.VarChar(64)
  bizId     String
  fieldName String   @db.VarChar(64)
  createdAt DateTime @default(now())

  file UploadFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([bizType, bizId])
  @@index([fileId])
}

model DailyTask {
  id                    String    @id @default(cuid())
  tenantId              String
  mediaAccountId        String
  platform              String    @db.VarChar(32) // media_platform
  title                 String    @db.VarChar(255)
  postId                String?   @db.VarChar(64)
  authorName            String?   @db.VarChar(100)
  videoUrl              String
  coverFileId           String?
  coverUrl              String?
  copywriting           String?
  commentRequirement    String?
  commentExample        String?
  targetCommentCount    Int
  rewardAmount          Int       @default(0)
  claimedCommentCount   Int       @default(0)
  completedCommentCount Int       @default(0)
  publishedAt           DateTime?
  stepConfig            Json?
  status                String    @default("DRAFT") @db.VarChar(32) // daily_task_status
  distributionScope     String    @default("TENANT") @db.VarChar(32) // TENANT / GROUP
  distributionGroupId   String?
  allowGroupCollaboration Boolean @default(false)
  // 团长分佣为任务发布时的财务快照：rewardAmount 始终表示成员端可见/可结算金额。
  // taskBudgetAmount 是管理端输入的任务金额；INCLUDED 模式会从中扣除团长佣金，EXTRA 模式则额外计入团长佣金。
  commissionEnabled     Boolean   @default(false)
  commissionRuleId      String?
  taskBudgetAmount      Int       @default(0)
  commissionMode        String?   @db.VarChar(16) // INCLUDED / EXTRA
  commissionRuleType    String?   @db.VarChar(16) // PERCENT / FIXED
  commissionRuleValue   Int?
  commissionAmount      Int       @default(0)
  commissionGroupId     String?
  commissionLeaderUserId String?
  remark                String?
  dispatchedAt          DateTime?
  completedAt           DateTime?
  deletedAt             DateTime?
  // 测试任务标记：仅在测试环境开启 ALLOW_TEST_DATA_PURGE 后，允许清理已领取/已结算等完整测试链路。
  isTestData            Boolean   @default(false)
  testMarkedAt          DateTime?
  testMarkedById        String?
  // 新测试任务必须明确归属一个测试批次；清理范围只按批次，不再递归猜测关联关系。
  testBatchId           String?
  createdById           String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  tenant       Tenant               @relation(fields: [tenantId], references: [id])
  mediaAccount MediaAccount         @relation(fields: [mediaAccountId], references: [id])
  createdBy    User                 @relation("DailyTaskCreator", fields: [createdById], references: [id])
  videoLinks   DailyTaskVideoLink[]
  comments     TaskComment[]
  dispatches   TaskDispatch[]
  participants TaskParticipant[]
  abandonLogs  TaskAbandonLog[]
  testBatch    TestDataBatch? @relation("TestBatchTasks", fields: [testBatchId], references: [id], onDelete: SetNull)

  @@unique([tenantId, platform, postId])
  @@index([tenantId, platform])
  @@index([distributionGroupId])
  @@index([distributionScope])
  @@index([commissionGroupId])
  @@index([commissionLeaderUserId])
  @@index([allowGroupCollaboration])
  @@index([mediaAccountId])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([isTestData])
  @@index([testBatchId])
  @@index([distributionGroupId, status])
}

model DailyTaskVideoLink {
  id        String   @id @default(cuid())
  taskId    String
  url       String
  isPrimary Boolean  @default(false)
  sort      Int      @default(0)
  createdAt DateTime @default(now())

  task DailyTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model TaskComment {
  id            String    @id @default(cuid())
  taskId        String
  content       String
  status        String    @default("AVAILABLE") @db.VarChar(32) // task_comment_status
  assigneeId    String?
  participantId String?
  claimerName   String?   @db.VarChar(50)
  assignedAt    DateTime?
  completedAt   DateTime?
  source        String    @default("MANUAL") @db.VarChar(32) // comment_source
  regionCode    String?
  sort          Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  task        DailyTask        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assignee    User?            @relation("CommentAssignee", fields: [assigneeId], references: [id])
  participant TaskParticipant? @relation(fields: [participantId], references: [id])

  @@index([taskId])
  @@index([status])
  @@index([assigneeId])
  @@index([participantId])
}

model TaskParticipant {
  id                    String    @id @default(cuid())
  taskId                String
  visitorToken          String    @unique @db.VarChar(64)
  visitorName           String?   @db.VarChar(50)
  phone                 String?   @db.VarChar(20)
  taskAccountId         String?
  taskAccountPhone      String?   @db.VarChar(20)
  taskAccountNickname   String?   @db.VarChar(80)
  primaryGroupId        String?
  taskOwnerGroupId      String?
  participantGroupId    String?
  sourceCollaborationId String?
  commissionBaseAmount  Int       @default(0)
  commissionCalculated  Boolean   @default(false)
  // 领取时复制任务分佣快照，后续即使团长规则调整也不重新计算。
  leaderCommissionEnabled      Boolean   @default(false)
  leaderCommissionGroupId      String?
  leaderCommissionLeaderUserId String?
  leaderCommissionMode         String?   @db.VarChar(16)
  leaderCommissionAmount       Int       @default(0)
  leaderCommissionSettledAt    DateTime?
  // 从任务批次复制，避免成员后续换团队影响测试订单归属。
  testBatchId            String?
  uploadedImageFileId   String?
  uploadedImageUrl      String?
  status                String    @default("STARTED") @db.VarChar(32) // task_participant_status
  settlementStatus      String    @default("UNSETTLED") @db.VarChar(32) // UNSETTLED / SETTLED
  settlementAmount      Int?
  settlementOrderNo     String?   @db.VarChar(128)
  settlementProofFileId String?
  settlementProofUrl    String?
  settlementRemark      String?
  rejectedAt            DateTime?
  resubmitStartedAt     DateTime?
  settledAt             DateTime?
  settledById           String?
  appUserId             String?
  mediaAccountNo        String?   @db.VarChar(100)
  proofOcrStatus        String?   @default("PENDING") @db.VarChar(32)
  proofOcrText          String?
  abandonedAt           DateTime?
  abandonReason         String?
  sourcePlatform        String?   @db.VarChar(32) // H5 / MINI_PROGRAM
  ip                    String?
  userAgent             String?
  startedAt             DateTime?
  claimedAt             DateTime?
  completedAt           DateTime?
  lastActiveAt          DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  task        DailyTask        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  settledBy   User?            @relation("TaskParticipantSettler", fields: [settledById], references: [id])
  appUser     AppUser?         @relation(fields: [appUserId], references: [id])
  abandonLogs TaskAbandonLog[]
  comments    TaskComment[]
  testBatch   TestDataBatch? @relation("TestBatchParticipants", fields: [testBatchId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([status])
  @@index([visitorName])
  @@index([phone])
  @@index([taskAccountId])
  @@index([taskAccountPhone])
  @@index([primaryGroupId])
  @@index([participantGroupId])
  @@index([appUserId])
  @@index([mediaAccountNo])
  @@index([settlementStatus])
  @@index([rejectedAt])
  @@index([resubmitStartedAt])
  @@index([settledAt])
  @@index([leaderCommissionGroupId])
  @@index([leaderCommissionLeaderUserId])
  @@index([testBatchId])
}

model TaskDispatch {
  id         String   @id @default(cuid())
  taskId     String
  operatorId String
  status     String   @default("PENDING") @db.VarChar(32) // dispatch_status
  message    String?
  createdAt  DateTime @default(now())

  task DailyTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([status])
}

model OperationLog {
  id          String   @id @default(cuid())
  operatorId  String
  tenantId    String?
  module      String   @db.VarChar(64)
  action      String   @db.VarChar(64)
  bizId       String?
  description String?
  beforeData  Json?
  afterData   Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([operatorId])
  @@index([tenantId])
  @@index([module, action])
  @@index([createdAt])
}

// 行业 AI 机器人模块与既有评论/私信/截流机器人完全隔离：
// 仅用于行业能力包配置与 DeepSeek 后台聊天测试，当前不参与任何已有机器人执行或消息发送链路。

// 智能客服经营 Agent V5 独立数据域。承载配置资产、角色、行业、回复规则、质量规则与测试案例；
// 当前仅用于 SIMULATION，不参与旧机器人运行、客户消息发送、Coze 路由或真实业务写动作。

// V5.17 店铺级稳定业务背景。profile 使用结构化 JSON 保存品牌、经营事实、服务规则、
// 权限边界、有效期和正反例；运行时只读取 ENABLED 记录。

// V5.17 账号级身份、渠道、人际距离和权限覆盖。店铺背景、角色与行业能力在这里绑定，
// 避免把长期账号资料塞进意图或复制进角色原型。

// V5.17 可复用语言与输出规则集。scopeType/scopeKey 支持全局、店铺、账号、角色、
// 渠道、场景和意图；rules 为逐条可编辑规则，styleGuidance 保存正向表达方向与示例。

// V5.20-T3 账号/店铺级可检索业务知识。只有 ENABLED 且处于有效期内的记录可进入运行时。

// Stage 2E-R2B Business Knowledge V2：知识集合用于组织行业/店铺知识，绑定决定哪些角色/账号/店铺可消费。

// V5.20-T4 事实错误校准形成的知识修订草稿。草稿必须经人工核实后才能发布到正式知识。

// HVE-2 统一 Guideline Policy。Header 仅保存稳定身份；所有影响 Runtime 的内容必须进入 Version。

model AppUser {
  proofUploads UploadFile[]
  id                   String    @id @default(cuid())
  tenantId             String?
  phone                String?   @unique @db.VarChar(20)
  nickname             String?   @db.VarChar(80)
  avatarUrl            String?
  wechatOpenid         String?   @unique @db.VarChar(128)
  serviceOpenid        String?   @unique @db.VarChar(128)
  unionid              String?   @db.VarChar(128)
  status               String    @default("ENABLED") @db.VarChar(32)
  bannedUntil          DateTime?
  banReason            String?
  // 测试账号仅用于独立测试范围。只有明确标记的账号才允许参与强制测试清理。
  isTestData           Boolean   @default(false)
  testMarkedAt         DateTime?
  testMarkedById       String?
  totalCompletedOrders Int       @default(0)
  totalSettledAmount   Int       @default(0)
  balanceAmount        Int       @default(0)
  withdrawnAmount      Int       @default(0)
  lastLoginAt          DateTime?
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  participants  TaskParticipant[]
  mediaAccounts AppUserMediaAccount[]
  restrictions  AppUserRestriction[]
  abandonLogs   TaskAbandonLog[]
  walletLedgers AppUserWalletLedger[]
  tenant       Tenant?                @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  withdrawals   AppUserWithdrawal[]
  testBatchMemberships TestDataBatchUser[]

  @@index([tenantId])
  @@index([status])
  @@index([isTestData])
  @@index([bannedUntil])
  @@index([createdAt])
}

model AppUserMediaAccount {
  id          String    @id @default(cuid())
  appUserId   String
  platform    String    @db.VarChar(32)
  accountNo   String    @db.VarChar(100)
  accountName String?   @db.VarChar(100)
  source      String    @default("MANUAL") @db.VarChar(32)
  proofFileId String?
  proofUrl    String?
  ocrText     String?
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  appUser AppUser @relation(fields: [appUserId], references: [id], onDelete: Cascade)

  @@unique([appUserId, platform, accountNo])
  @@index([platform, accountNo])
}

model AppUserRestriction {
  id               String   @id @default(cuid())
  appUserId        String
  operatorId       String?
  reason           String
  screenshotFileId String?
  screenshotUrl    String?
  days             Int
  startedAt        DateTime @default(now())
  endsAt           DateTime
  status           String   @default("ACTIVE") @db.VarChar(32)
  createdAt        DateTime @default(now())

  appUser  AppUser @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  operator User?   @relation("AppUserRestrictionOperator", fields: [operatorId], references: [id])

  @@index([appUserId, status])
  @@index([endsAt])
}

model TaskAbandonLog {
  id            String   @id @default(cuid())
  appUserId     String
  taskId        String
  participantId String?
  reason        String?
  createdAt     DateTime @default(now())

  appUser     AppUser          @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  task        DailyTask        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  participant TaskParticipant? @relation(fields: [participantId], references: [id])

  @@index([appUserId, createdAt])
  @@index([taskId])
}

model AppUserWalletLedger {
  id            String   @id @default(cuid())
  appUserId     String
  participantId String?
  // 结算/佣金从订单批次继承；提现/调账只有明确归属时才写入批次。
  testBatchId   String?
  type          String   @db.VarChar(32) // SETTLEMENT / WITHDRAW / ADJUST
  amount        Int
  balanceAfter  Int
  remark        String?
  createdAt     DateTime @default(now())

  appUser AppUser @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  testBatch TestDataBatch? @relation("TestBatchWalletLedgers", fields: [testBatchId], references: [id], onDelete: SetNull)

  @@index([appUserId, createdAt])
  @@index([participantId])
  @@index([testBatchId])
}

model AppUserWithdrawal {
  id                      String    @id @default(cuid())
  appUserId               String
  tenantId                String?
  // 只有明确属于测试批次的提现才会随测试批次清理。
  testBatchId             String?
  amount                  Int
  channel                 String    @default("WECHAT_TRANSFER") @db.VarChar(32)
  transferMode            String    @default("WECHAT") @db.VarChar(32) // WECHAT / MANUAL / MOCK
  status                  String    @default("PENDING") @db.VarChar(32) // PENDING / APPROVED / WAIT_USER_CONFIRM / PROCESSING / PAID / REJECTED / FAILED / CANCELLED / EXPIRED
  outBatchNo              String?   @db.VarChar(128)
  outDetailNo             String?   @db.VarChar(128)
  outBillNo               String?   @unique @db.VarChar(32)
  tradeNo                 String?   @db.VarChar(128)
  transferBillNo          String?   @db.VarChar(128)
  transferState           String?   @db.VarChar(64)
  transferPackageInfo     String?
  transferPackageExpireAt DateTime?
  transferMchId           String?   @db.VarChar(32)
  transferAppId           String?   @db.VarChar(32)
  rejectReason            String?
  failReason              String?
  operatorId              String?
  notifyRaw               Json?
  remark                  String?
  approvedAt              DateTime?
  paidAt                  DateTime?
  rejectedAt              DateTime?
  failedAt                DateTime?
  cancelledAt             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  appUser AppUser @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  tenant  Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  testBatch TestDataBatch? @relation("TestBatchWithdrawals", fields: [testBatchId], references: [id], onDelete: SetNull)

  @@index([appUserId, status])
  @@index([tenantId, status])
  @@index([transferMode])
  @@index([testBatchId])
  @@index([createdAt])
}

model TestDataBatch {
  id           String   @id @default(cuid())
  tenantId     String
  name         String   @db.VarChar(120)
  purpose      String?  @db.VarChar(500)
  status       String   @default("ACTIVE") @db.VarChar(32) // ACTIVE / ARCHIVED / PURGED
  createdById  String?
  archivedAt   DateTime?
  archivedById String?
  purgedAt     DateTime?
  purgedById   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant        Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tasks         DailyTask[]                  @relation("TestBatchTasks")
  participants  TaskParticipant[]            @relation("TestBatchParticipants")
  walletLedgers AppUserWalletLedger[]        @relation("TestBatchWalletLedgers")
  withdrawals   AppUserWithdrawal[]          @relation("TestBatchWithdrawals")
  commissions   LeaderCommissionSettlement[] @relation("TestBatchCommissionSettlements")
  users         TestDataBatchUser[]
  groups        TestDataBatchGroup[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@index([createdAt])
}

model TestDataBatchUser {
  id          String   @id @default(cuid())
  batchId     String
  appUserId   String
  role        String   @default("MEMBER") @db.VarChar(32) // MEMBER / LEADER / OPERATOR
  createdById String?
  createdAt   DateTime @default(now())

  batch   TestDataBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  appUser AppUser       @relation(fields: [appUserId], references: [id], onDelete: Cascade)

  @@unique([batchId, appUserId])
  @@index([appUserId, createdAt])
}

model TestDataBatchGroup {
  id          String   @id @default(cuid())
  batchId     String
  groupId     String
  createdById String?
  createdAt   DateTime @default(now())

  batch TestDataBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, groupId])
  @@index([groupId, createdAt])
}

model DistributionGroup {
  id                      String    @id @default(cuid())
  tenantId                String
  name                    String    @db.VarChar(100)
  leaderName              String?   @db.VarChar(80)
  leaderPhone             String?   @db.VarChar(20)
  leaderUserId            String?
  leaderTaskAccountId     String?
  memberInviteCode        String    @unique @db.VarChar(32)
  leaderBindCode          String    @unique @db.VarChar(64)
  // 生命周期：ENABLED / DISABLED / UNBINDING / UNBOUND / RESETTING / DELETED。
  // status 仅控制当前运营可用性；解绑、删除和测试重置均保留必要历史归属。
  status                  String    @default("ENABLED") @db.VarChar(32)
  isTestData              Boolean   @default(false)
  leaderUnboundAt         DateTime?
  leaderUnboundById       String?
  deletedAt               DateTime?
  deletedById             String?
  testResetAt             DateTime?
  testResetById           String?
  commissionEnabled       Boolean   @default(false)
  // 团长默认接受的分佣规则：PERCENT 的值为基点（500 = 5.00%），FIXED 的值为分（10 = ¥0.10）。
  commissionRuleType      String?   @db.VarChar(16)
  commissionRuleValue     Int?
  selfCommissionEnabled   Boolean   @default(false)
  defaultCommissionRuleId String?
  remark                  String?
  createdById             String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  disabledAt              DateTime?

  @@index([tenantId, status])
  @@index([deletedAt])
  @@index([isTestData])
  @@index([leaderUserId])
  @@index([leaderPhone])
  @@index([createdAt])
}

model DistributionUserBinding {
  id         String    @id @default(cuid())
  userId     String
  tenantId   String
  groupId    String
  status     String    @default("ENABLED") @db.VarChar(32)
  bindSource String    @default("INVITE") @db.VarChar(32)
  inviteCode String?   @db.VarChar(64)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  unbindAt   DateTime?

  @@index([userId, status])
  @@index([tenantId, groupId, status])
  @@index([groupId, status])
}

model DistributionTaskAccount {
  id                   String                                      @id @default(cuid())
  userId               String
  tenantId             String
  groupId              String
  phone                String                                      @unique @db.VarChar(20)
  nickname             String                                      @db.VarChar(80)
  smsVerified          Boolean                                     @default(false)
  status               String                                      @default("ENABLED") @db.VarChar(32)
  isDefault            Boolean                                     @default(false)
  createdAt            DateTime                                    @default(now())
  updatedAt            DateTime                                    @updatedAt
  homepageRecognitions DistributionTaskAccountHomepageRecognition[]

  @@index([userId, status])
  @@index([tenantId, groupId, status])
  @@index([groupId, status])
}

/// 团长申请：H5 用户提交，PC 审核通过后才会提升为团长，避免自行获得团队权限。
model DistributionLeaderApplication {
  id                 String   @id @default(cuid())
  tenantId           String?
  appUserId          String
  currentGroupId     String?
  requestedGroupName String   @db.VarChar(100)
  // 申请人可确认/补充联系方式；审核通过后仍以当前 H5 用户资料为准。
  contactPhone       String?  @db.VarChar(20)
  agreedToLeaderRules Boolean @default(false)
  reason             String?
  status             String   @default("PENDING") @db.VarChar(32) // PENDING / APPROVING (transactional guard) / APPROVED / REJECTED / CANCELLED
  reviewRemark       String?
  reviewedById       String?
  reviewedAt         DateTime?
  groupId            String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([appUserId, status])
  @@index([tenantId, status, createdAt])
  @@index([groupId])
  @@index([createdAt])
}

/// 团长佣金结算明细：每个任务参与记录最多产生一条，独立于成员任务结算。
model LeaderCommissionSettlement {
  id                 String   @id @default(cuid())
  tenantId           String
  groupId            String
  leaderUserId       String
  taskId             String
  participantId      String   @unique
  workerUserId       String?
  workerRewardAmount Int
  commissionAmount   Int
  commissionMode     String   @db.VarChar(16) // INCLUDED / EXTRA
  status             String   @default("SETTLED") @db.VarChar(32)
  settledAt          DateTime @default(now())
  settledById        String?
  remark             String?
  testBatchId        String?
  createdAt          DateTime @default(now())

  testBatch TestDataBatch? @relation("TestBatchCommissionSettlements", fields: [testBatchId], references: [id], onDelete: SetNull)

  @@index([tenantId, settledAt])
  @@index([leaderUserId, settledAt])
  @@index([groupId, settledAt])
  @@index([taskId])
  @@index([testBatchId])
}

/// OCR 仅用于主页截图的运营核验；绝不覆盖 DistributionTaskAccount.nickname 或手机号。
model DistributionTaskAccountHomepageRecognition {
  id                  String                  @id @default(cuid())
  taskAccountId       String
  expectedPlatform    String                  @db.VarChar(32)
  homepageProofFileId String?                 @db.VarChar(64)
  detectedPlatform    String?                 @db.VarChar(32)
  platformConfidence  Int?
  nicknameCandidate   String?                 @db.VarChar(100)
  accountIdCandidate  String?                 @db.VarChar(100)
  ocrStatus           String                  @default("NOT_REQUESTED") @db.VarChar(32)
  ocrText             String?
  ocrError            String?                 @db.VarChar(500)
  ocrAttemptCount     Int                     @default(0)
  ocrRequestedAt      DateTime?
  ocrStartedAt        DateTime?
  ocrCompletedAt      DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  taskAccount DistributionTaskAccount @relation(fields: [taskAccountId], references: [id], onDelete: Cascade)

  @@unique([taskAccountId, expectedPlatform])
  @@index([ocrStatus, updatedAt])
  @@index([homepageProofFileId])
}

model GroupCollaboration {
  id                         String    @id @default(cuid())
  tenantId                   String
  sourceGroupId              String
  targetGroupId              String
  scopeType                  String    @default("ALL_COLLABORATIVE_TASKS") @db.VarChar(64)
  status                     String    @default("APPROVED") @db.VarChar(32)
  allowAllCollaborativeTasks Boolean   @default(true)
  startAt                    DateTime?
  endAt                      DateTime?
  createdById                String?
  approvedById               String?
  approvedAt                 DateTime?
  revokedAt                  DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  @@index([tenantId, status])
  @@index([sourceGroupId, targetGroupId, status])
  @@index([targetGroupId, status])
  @@index([endAt])
}
