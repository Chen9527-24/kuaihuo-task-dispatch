# 复制为 .env 后填写，真实 .env 不应提交。字段说明见 README.md。
# 必填空值：DATABASE_URL、JWT_ACCESS_SECRET、JWT_REFRESH_SECRET。
# 使用本地 Compose 时还需 POSTGRES_PASSWORD；首次初始化需 SEED_ADMIN_USERNAME/PASSWORD。

# 应用与本地依赖
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
APP_NAME=快火任务分发
APP_ORIGIN=http://localhost:5173,http://localhost:5174
APP_BASE_URL=http://localhost:3000
H5_BASE_URL=http://localhost:5174
API_BASE_URL=http://localhost:3000
APP_TRUST_PROXY_HOPS=0
POSTGRES_DB=task_dispatch
POSTGRES_USER=task_dispatch
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
REDIS_PORT=6379
# 自行填写：postgresql://用户名:URL编码后的密码@127.0.0.1:5432/数据库名?schema=public
DATABASE_URL=
REDIS_URL=redis://127.0.0.1:6379

# JWT 每项分别填写随机密钥，至少 32 字符，两个值必须不同
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=7d
HASH_SALT_ROUNDS=10

# 初始化账号：没有默认密码。seed 仅用于已确认的开发数据库
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_TENANT_CODE=ADMIN-TENANT-DEFAULT
SEED_ADMIN_TENANT_NAME=管理员租户
ALLOW_PRODUCTION_SEED=false
# 仅手工重置管理员密码时填写
ADMIN_RESET_USERNAME=
ADMIN_RESET_PASSWORD=

# 文件：默认本地存储，不需要云账户
UPLOAD_DRIVER=local
UPLOAD_MAX_FILE_SIZE_MB=20
LOCAL_UPLOAD_DIR=uploads
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=
OSS_CDN_BASE_URL=
OSS_OBJECT_PREFIX=uploads
TENCENT_COS_ENABLED=false
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_REGION=ap-guangzhou
TENCENT_COS_BUCKET=
TENCENT_COS_PREFIX=media
TENCENT_COS_SCHEME=https
TENCENT_COS_SIGNED_URL_TTL_SECONDS=600
TENCENT_COS_THUMBNAIL_URL_TTL_SECONDS=3600
TENCENT_COS_PRIVATE_SCENES=TASK_CLAIM_PROOF,TASK_SETTLEMENT_PROOF
TENCENT_COS_THUMBNAIL_MAX_LONG_EDGE=320
TENCENT_COS_THUMBNAIL_QUALITY=80

# 主页图片 OCR，默认关闭
TENCENT_OCR_ENABLED=false
TENCENT_OCR_SECRET_ID=
TENCENT_OCR_SECRET_KEY=
TENCENT_OCR_REGION=ap-guangzhou
TENCENT_OCR_REQUEST_TIMEOUT_MS=25000
TENCENT_OCR_MAX_IMAGE_BYTES=5242880

# DeepSeek：不填写 Key 时不能使用模型生成功能
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_MS=600000
DAILY_TASK_AI_FALLBACK_TO_COZE=false

# Coze 兼容路径：需要自己的凭据和工作流。本项目不包含云端工作流资产
COZE_API_BASE_URL=https://api.coze.cn
COZE_API_PAT=
COZE_PERSONAL_ACCESS_TOKEN=
COZE_SERVICE_ACCESS_TOKEN=
COZE_AUTH_MODE=
COZE_OAUTH_APP_ID=
COZE_OAUTH_PUBLIC_KEY_ID=
COZE_OAUTH_PRIVATE_KEY=
COZE_OAUTH_AUDIENCE=api.coze.cn
COZE_OAUTH_DURATION_SECONDS=3600
COZE_WORKFLOW_ID=
COZE_GENERATE_COMMENTS_TIMEOUT_MS=600000

# 短信：默认 mock，仅用于本地开发；真实发送请切换 tencent 并配置模板
SMS_PROVIDER=mock
SMS_ENABLED=true
SMS_CODE_TTL_SECONDS=300
SMS_CODE_RESEND_INTERVAL_SECONDS=60
SMS_CODE_MAX_ATTEMPTS=5
SMS_PHONE_DAILY_LIMIT=20
SMS_IP_DAILY_LIMIT=100
SMS_NOTIFICATION_RESEND_INTERVAL_SECONDS=60
SMS_NOTIFICATION_PHONE_DAILY_LIMIT=20
SMS_MOCK_CODE=
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_REGION=ap-guangzhou
TENCENT_SMS_EXTEND_CODE=
TENCENT_SMS_CODE_TEMPLATE_ID=
TENCENT_SMS_TEMPLATE_TASK_REJECTED_ID=
TENCENT_SMS_TEMPLATE_TASK_SETTLED_ID=
TENCENT_SMS_TEMPLATE_WITHDRAWAL_APPROVED_ID=
TENCENT_SMS_TEMPLATE_WITHDRAWAL_REJECTED_ID=
TENCENT_SMS_TEMPLATE_ACCOUNT_DISABLED_ID=

# 微信小程序 / 公众号；不填则相关授权和开放能力不可用
WECHAT_MINI_APPID=
WECHAT_MINI_SECRET=
WECHAT_MINI_CODE_PAGE=pages/Home
WECHAT_MINI_ENV_VERSION=release
WECHAT_SCENE_TTL_SECONDS=2592000
MINI_PROGRAM_FORCE_MODE=
MINI_PROGRAM_AUDIT_VERSION=
MINI_PROGRAM_AUDIT_VERSIONS=
MINI_PROGRAM_AUDIT_ENABLED=false
WECHAT_MP_APPID=
WECHAT_MP_SECRET=
WECHAT_MP_ORIGINAL_ID=
WECHAT_MP_OAUTH_CALLBACK_PATH=/api/v1/wechat/oauth/callback
WECHAT_MP_OAUTH_SCOPE=snsapi_base
WECHAT_MP_OAUTH_ALLOWED_RETURN_ORIGINS=http://localhost:5174
WECHAT_MP_TASK_TEMPLATE_ID=
WECHAT_MP_TASK_NOTIFY_LIMIT=100

# 提现默认 MOCK，不发送真实付款请求
WECHAT_PAY_TRANSFER_MODE=MOCK
WECHAT_WITHDRAW_REVIEW_REQUIRED=true
WECHAT_WITHDRAW_MIN_AMOUNT_FEN=1
WECHAT_WITHDRAW_MAX_AMOUNT_FEN=20000
WECHAT_PAY_MCH_ID=
WECHAT_PAY_APP_ID=
WECHAT_PAY_API_BASE_URL=https://api.mch.weixin.qq.com
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_MERCHANT_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_PUBLIC_KEY_PATH=
WECHAT_PAY_TRANSFER_SCENE_ID=
WECHAT_PAY_USER_RECV_PERCEPTION=现金奖励
WECHAT_PAY_NOTIFY_URL=
WECHAT_PAY_TRANSFER_SCENE_REPORT_INFOS=

# 管理员清理测试标记数据的开关，默认关闭
ALLOW_TEST_DATA_PURGE=false
