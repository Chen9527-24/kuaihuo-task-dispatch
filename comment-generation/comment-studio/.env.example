# 保存为 .env 后填写需要启用的服务，网址和模型 ID 以本账号控制台为准。
# 本地 Python 启动时可在同一终端执行 set -a; . ./.env; set +a。

# 工作台与费用限制
COMMENT_PORT=8766
COMMENT_DEFAULT_PROVIDER=qwen
COMMENT_MAX_COMMENTS=100
COMMENT_MEDIA_HOURS=24
COMMENT_MAX_MINUTES=10
COMMENT_MAX_MEDIA_MB=100
COMMENT_WORKERS=2
COMMENT_DAILY_CALLS=100
COMMENT_MONTHLY_CALLS=1500
COMMENT_DAILY_ASR_SECONDS=3600
COMMENT_MONTHLY_ASR_SECONDS=36000
# 可选人民币预算。启用后请填写实际使用的文本服务单价，单位为元/百万 Token。
# COMMENT_DAILY_CNY=
# COMMENT_MONTHLY_CNY=
# COMMENT_QWEN_INPUT_CNY_PER_M=
# COMMENT_QWEN_OUTPUT_CNY_PER_M=
# COMMENT_DEEPSEEK_INPUT_CNY_PER_M=
# COMMENT_DEEPSEEK_OUTPUT_CNY_PER_M=
# COMMENT_ARK_INPUT_CNY_PER_M=
# COMMENT_ARK_OUTPUT_CNY_PER_M=
# COMMENT_ASR_CNY_PER_SECOND=0.00008
# COMMENT_FALLBACK_PROVIDER=deepseek
# COMMENT_DATA_DIR=/path/to/comment-studio-data

# 千问文本与百炼录音识别
# DASHSCOPE_API_KEY=
# QWEN_API_KEY=
# QWEN_BASE_URL=https://你的业务空间.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=

# 可选文本服务，配置自己的模型和凭据
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=
# ARK_API_KEY=
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# ARK_MODEL=

# 非容器启动时填自建解析服务的基础地址；Compose 使用 http://parser:8000。
# COMMENT_PARSER_URL=http://127.0.0.1:8000
# COMMENT_PARSER_USERNAME=
# COMMENT_PARSER_PASSWORD=

# 云端或本机转写
COMMENT_ASR=paraformer
# COMMENT_VIDEO_STORAGE=oss
# COMMENT_ASR_BASE_URL=https://你的业务空间.cn-beijing.maas.aliyuncs.com
# OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
# OSS_BUCKET=
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_SECURITY_TOKEN=
# COMMENT_WHISPER_MODEL=small
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe
